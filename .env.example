# Copy to docker/.env and set strong values. Never commit docker/.env.

HMS_API_PORT=8080
HMS_WEB_PORT=8088

# --- External PostgreSQL (native server — NOT a Docker container) ---
# HMS API connects using OFBIZ_POSTGRES_* (Entity Engine). DB_* aliases are supported for clarity.
#
# From Docker Desktop on Windows/macOS, use host.docker.internal to reach PostgreSQL on the host.
# On Linux Docker, host.docker.internal is added via compose extra_hosts (host-gateway).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ofbiz_hms
DB_USER=hms_app
DB_PASSWORD=change_me_app

OFBIZ_POSTGRES_HOST=
OFBIZ_POSTGRES_PORT=
OFBIZ_POSTGRES_JDBC_PARAMS=
OFBIZ_POSTGRES_OFBIZ_DB=
OFBIZ_POSTGRES_OFBIZ_USER=
OFBIZ_POSTGRES_OFBIZ_PASSWORD=

# Single-DB setup (OLAP + tenant groups use the same database/user as OFBiz when left empty)
OFBIZ_POSTGRES_OLAP_DB=
OFBIZ_POSTGRES_OLAP_USER=
OFBIZ_POSTGRES_OLAP_PASSWORD=
OFBIZ_POSTGRES_TENANT_DB=
OFBIZ_POSTGRES_TENANT_USER=
OFBIZ_POSTGRES_TENANT_PASSWORD=

# Native PostgreSQL admin (Windows/Linux install)
NATIVE_POSTGRES_HOST=localhost
NATIVE_POSTGRES_PORT=5432
NATIVE_POSTGRES_ADMIN_USER=postgres
NATIVE_POSTGRES_ADMIN_PASSWORD=change_me_native_superuser

# Superuser used only to run grant scripts (fallback if NATIVE_* unset)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_superuser

# Native streaming replication (standby on host port 5433 — not used by hms-api)
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change_me_replication

# --- HMS table-level access roles (same database as DB_NAME) ---
POSTGRES_HMS_FULL_ACCESS_USER=hms_db_full
POSTGRES_HMS_FULL_ACCESS_PASSWORD=change_me_full_access
POSTGRES_HMS_WRITE_ACCESS_USER=hms_db_write
POSTGRES_HMS_WRITE_ACCESS_PASSWORD=change_me_write_access
POSTGRES_HMS_READ_ONLY_USER=hms_db_read
POSTGRES_HMS_READ_ONLY_PASSWORD=change_me_read_only

# --- HMS API (OFBiz) ---
HMS_TENANT_ID=hms
HMS_APPOINTMENT_TIMEZONE=Asia/Karachi

SUBSCRIPTION_DAYS=0
SUBSCRIPTION_START_DATE=

OFBIZ_DATA_LOAD=none
OFBIZ_SKIP_INIT=

# --- HMS Web ---
VITE_HMS_TENANT_ID=hms
VITE_HMS_BUSINESS_TIMEZONE=Asia/Karachi
